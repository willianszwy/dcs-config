<?xml version="1.0" encoding="utf-8"?>
<HeliosProfile>
  <Version>3</Version>
  <Monitors>
    <Monitor>
      <Location>0,0</Location>
      <Size>3440,1440</Size>
      <Hidden>False</Hidden>
      <Orientation>DMDO_DEFAULT</Orientation>
      <AlwaysOnTop>True</AlwaysOnTop>
      <Background />
      <Children />
    </Monitor>
    <Monitor>
      <Location>3440,0</Location>
      <Size>1920,1080</Size>
      <Hidden>False</Hidden>
      <Orientation>DMDO_180</Orientation>
      <AlwaysOnTop>True</AlwaysOnTop>
      <Background />
      <Children>
        <Control TypeIdentifier="Helios.AH64D.MFD.PLTLEFT" Name="MFD Left (Pilot)" SnapTarget="True" Locked="False">
          <Location>60,140</Location>
          <Size>800,800</Size>
          <Hidden>False</Hidden>
          <EmbeddedViewportName>AH_64D_LEFT_MFCD_PLT</EmbeddedViewportName>
          <RequiresPatches>True</RequiresPatches>
          <Children />
        </Control>
        <Control TypeIdentifier="Helios.AH64D.MFD.PLTRIGHT" Name="MFD Right (Pilot)" SnapTarget="True" Locked="False">
          <Location>1060,140</Location>
          <Size>800,800</Size>
          <Hidden>False</Hidden>
          <EmbeddedViewportName>AH_64D_RIGHT_MFCD_PLT</EmbeddedViewportName>
          <RequiresPatches>True</RequiresPatches>
          <Children />
        </Control>
        <Control TypeIdentifier="Helios.AH64D.MFD.CPGLEFT" Name="MFD Left (CP/G)" SnapTarget="True" Locked="False">
          <Location>60,140</Location>
          <Size>800,800</Size>
          <Hidden>True</Hidden>
          <EmbeddedViewportName>AH_64D_LEFT_MFCD_CPG</EmbeddedViewportName>
          <RequiresPatches>True</RequiresPatches>
          <Children />
        </Control>
        <Control TypeIdentifier="Helios.AH64D.MFD.CPGRIGHT" Name="MFD Right (CP/G)" SnapTarget="True" Locked="False">
          <Location>1060,140</Location>
          <Size>800,800</Size>
          <Hidden>True</Hidden>
          <EmbeddedViewportName>AH_64D_RIGHT_MFCD_CPG</EmbeddedViewportName>
          <RequiresPatches>True</RequiresPatches>
          <Children />
        </Control>
        <Control TypeIdentifier="Helios.Base.PushButton" Name="Switch PLT" SnapTarget="True" Locked="False">
          <Location>820,30</Location>
          <Size>120,60</Size>
          <Hidden>False</Hidden>
          <Type>Momentary</Type>
          <Image>{Helios}/Images/Buttons/tactile-light-square.png</Image>
          <PushedImage>{Helios}/Images/Buttons/tactile-light-square-in.png</PushedImage>
          <Children />
        </Control>
        <Control TypeIdentifier="Helios.Base.PushButton" Name="Switch CPG" SnapTarget="True" Locked="False">
          <Location>980,30</Location>
          <Size>120,60</Size>
          <Hidden>False</Hidden>
          <Type>Momentary</Type>
          <Image>{Helios}/Images/Buttons/tactile-light-square.png</Image>
          <PushedImage>{Helios}/Images/Buttons/tactile-light-square-in.png</PushedImage>
          <Children />
        </Control>
      </Children>
    </Monitor>
  </Monitors>
  <Interfaces>
    <Interface TypeIdentifier="Helios.Base.ProfileInterface" Name="Profile" />
    <Interface TypeIdentifier="Helios.Base.Keyboard" Name="Keyboard">
      <KeyDelay>30</KeyDelay>
    </Interface>
    <Interface TypeIdentifier="Helios.AH64D" Name="DCS AH-64D Apache" />
    <Interface TypeIdentifier="Patching.DCS.MonitorSetup" Name="DCS Monitor Setup" />
    <Interface TypeIdentifier="Patching.DCS.AdditionalViewports" Name="DCS Additional Viewports" />
  </Interfaces>
  <Bindings>
